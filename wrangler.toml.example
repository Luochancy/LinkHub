# 部署模板：请复制为 wrangler.toml 后填入自己的值，不要把个人基建信息提交进仓库。
#
# 必填：
#   - routes[].pattern               你的自定义域名（或删除 [[routes]] 使用 workers.dev）
#   - kv_namespaces[].id             `wrangler kv namespace create LINKS_KV` 的输出
#   - 在 Cloudflare Dashboard 中填写 APP_URL、WP_LINKS_URL 等运行时变量
#
# 运行时变量和密钥都不要写在这里（本文件会进版本库），请在
# Cloudflare Dashboard → Settings → Variables and Secrets 中配置。
# 也可以用 `wrangler secret put` 配置 Secret：
#   wrangler secret put SESSION_SECRET       # 必填，openssl rand -base64 32
#   wrangler secret put GITHUB_CLIENT_ID
#   wrangler secret put GITHUB_CLIENT_SECRET
#   wrangler secret put WP_APPLICATION_PASSWORD
#   wrangler secret put ADMIN_GITHUB_IDS

name = "linkhub"
main = "src/server/worker.ts"
compatibility_date = "2025-06-01"
compatibility_flags = ["nodejs_compat"]
# 保留 Cloudflare Dashboard 中配置的变量和 Secrets。
keep_vars = true

[[routes]]
# 改成你自己的域名，或删除此段以使用 <worker>.<account>.workers.dev
pattern = "example.com"
custom_domain = true

[assets]
# 源文件在 index.html / static/，`npm run build` 后产物在 public/
directory = "public"
binding = "ASSETS"

[[kv_namespaces]]
binding = "LINKS_KV"
# 替换为 `wrangler kv namespace create LINKS_KV` 返回的 id
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"

# 运行时变量和 Secrets 全部在 Cloudflare Dashboard 中维护。
# 请勿在此添加 [vars]：同名配置会在部署时覆盖 Dashboard 中已有的值。
